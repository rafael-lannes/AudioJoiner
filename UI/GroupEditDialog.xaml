<Window x:Class="AudioJoiner.UI.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AudioJoiner.UI.Converters"
        mc:Ignorable="d"
        Title="Grupo de Dispositivos"
        Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DeviceIconToVectorConverter x:Key="DeviceIcon" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderDarkBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.6" ShadowDepth="6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Group Name Input -->
                <RowDefinition Height="Auto" /> <!-- Virtual Device Link Card -->
                <RowDefinition Height="*" />    <!-- Select Devices Checklist -->
                <RowDefinition Height="Auto" /> <!-- Validation / Error text -->
                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="TxtDialogTitle" Text="Unir Dispositivos em Saída do Windows" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Crie um dispositivo unificado que reúne múltiplos alto-falantes ou monitores físicos."
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 2. Group Name Field -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="NOME DO GRUPO (EX: ÁUDIO DOS MONITORES)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TxtGroupName"
                         Background="#1A1D27" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                         FontSize="13" Padding="10,8" Height="38">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <!-- 3. Virtual Device Link Card (Windows Endpoint) -->
            <Border Grid.Row="2" Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Fill="{StaticResource AccentSkyBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                              Data="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z" />
                        <TextBlock Text="VINCULAR A DISPOSITIVO DE SOM DO WINDOWS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" />
                    </StackPanel>
                    
                    <TextBlock Text="Permite que o Windows e jogos enviem áudio diretamente para este grupo."
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                    <ComboBox x:Name="CmbVirtualDevice" Style="{StaticResource ModernComboBox}" Height="34" FontSize="12"
                              DisplayMemberPath="Name" SelectionChanged="CmbVirtualDevice_SelectionChanged" />

                    <!-- Install virtual driver button / hint if needed -->
                    <StackPanel x:Name="PnlInstallDriver" Margin="0,8,0,0">
                        <Button x:Name="BtnInstallDriver" Style="{StaticResource SubtleIconButton}" Click="BtnInstallDriver_Click"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource AccentSkyBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" />
                                <TextBlock Text="Instalar Driver de Áudio Virtual (VB-CABLE Oficial)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSkyBrush}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtDriverStatus" Text="" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Device Selection Checklist -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SELECIONE OS DISPOSITIVOS MEMBROS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListSelectableDevices">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCardBrush}"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#2A2F40" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"
                                                  Data="{Binding Device.IconType, Converter={StaticResource DeviceIcon}}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <TextBlock Text="{Binding Device.FormatDescription}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 5. Validation Message -->
            <TextBlock Grid.Row="4" x:Name="TxtValidation" Text="" FontSize="11.5" Foreground="{StaticResource AccentCoralBrush}" Margin="0,0,0,10" Visibility="Collapsed" />

            <!-- 6. Action Buttons -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource SubtleIconButton}"
                        Height="38" Padding="18,0" Margin="0,0,10,0"
                        Click="BtnCancel_Click" />

                <Button Grid.Column="2" Content="Salvar Grupo" Style="{StaticResource PrimaryButton}"
                        Height="38" Padding="20,0"
                        Click="BtnSave_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
