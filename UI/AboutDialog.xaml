<Window x:Class="AudioJoiner.UI.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sobre o AudioJoiner"
        Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderDarkBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.7" ShadowDepth="6" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Description Card -->
                <RowDefinition Height="Auto" /> <!-- Developer Card -->
                <RowDefinition Height="Auto" /> <!-- Tech Stack -->
                <RowDefinition Height="*" />    <!-- Spacer -->
                <RowDefinition Height="Auto" /> <!-- Close Button -->
            </Grid.RowDefinitions>

            <!-- 1. Header (Logo & Title) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- App Logo Badge -->
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Color="#0EA5E9" Opacity="0.4" ShadowDepth="2" />
                    </Border.Effect>
                    <Path Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform"
                          Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Audio" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Joiner" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentSkyBrush}" />
                    <Border Background="#2A2F40" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Multi-Output Audio Cloner &amp; Splitter" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- 2. Description Card -->
            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <TextBlock Text="Aplicação desktop ultra-leve projetada para espelhar, clonar e unificar o áudio do Windows 10/11 para múltiplos dispositivos de saída físicos simultaneamente com latência ultra-baixa e controle individual de ganho."
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" TextAlignment="Center" />
            </Border>

            <!-- 3. Developer Card -->
            <Border Grid.Row="2" Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar / GitHub Icon -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#2A2F40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Fill="{StaticResource AccentSkyBrush}" Width="20" Height="20" Stretch="Uniform"
                              Data="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DESENVOLVEDOR" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Rafael Lannes" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0" />
                        <Button Style="{StaticResource SubtleIconButton}" Padding="0,2,0,0" HorizontalAlignment="Left"
                                Click="BtnOpenGithub_Click" Cursor="Hand" ToolTip="Abrir GitHub / Portfólio">
                            <TextBlock Text="rafael-lannes.github.io ↗" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentSkyBrush}" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>

                    <!-- Open Button -->
                    <Button Grid.Column="2" Style="{StaticResource SubtleIconButton}" Padding="8,6"
                            Click="BtnOpenGithub_Click" ToolTip="Visitar rafael-lannes.github.io" VerticalAlignment="Center">
                        <Border Background="#2A2F40" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="Visitar ↗" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Tech Stack Badge -->
            <Border Grid.Row="3" Background="#11131A" CornerRadius="6" Padding="10,6" Margin="0,0,0,14" HorizontalAlignment="Center">
                <TextBlock Text="C# 12 • .NET 8 • WPF Modern UI • NAudio WASAPI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
            </Border>

            <!-- 5. Close Button -->
            <Button Grid.Row="5" Content="Fechar" Style="{StaticResource PrimaryButton}"
                    Height="38" Padding="24,0" HorizontalAlignment="Center"
                    Click="BtnClose_Click" />
        </Grid>
    </Border>
</Window>
